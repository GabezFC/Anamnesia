# Codex: add to your Codex config (~/.codex/config.toml on Linux/macOS,
# %USERPROFILE%\.codex\config.toml on Windows). Not applied automatically.
# Replace <PROJECT_ROOT> with the absolute path of your Memory_Gateway checkout
# and adjust the interpreter path for your OS (.venv/bin/python on Linux/macOS).
[mcp_servers.memory-gateway]
command = "<PROJECT_ROOT>/.venv/Scripts/python.exe"
args = ["-m", "app.mcp.server"]
cwd = "<PROJECT_ROOT>"
