# Copy to .env and fill. Never commit .env. Only variables actually read by the code are listed.

# --- Vault (READ ONLY) ---
# Absolute or relative path to the Obsidian-style vault the Gateway reads notes from.
# Resolution precedence (see config/retrieval.py: resolve_vault_path):
#   1. explicit --vault argument
#   2. MEMORY_GATEWAY_VAULT (canonical)
#   3. OBSIDIAN_VAULT_PATH (legacy alias, still supported)
#   4. bundled example corpus ./data/synthetic_vault
MEMORY_GATEWAY_VAULT=./data/synthetic_vault
# Linux/macOS example:   MEMORY_GATEWAY_VAULT=/home/user/notes
# Windows example:       MEMORY_GATEWAY_VAULT=C:/Users/YourUser/Documents/MyVault
# Legacy alias, kept for backwards compatibility. Prefer MEMORY_GATEWAY_VAULT.
# OBSIDIAN_VAULT_PATH=

# --- JEV / TypeSafe (typesafe-sdk reads TYPESAFE_API_KEY itself) ---
# Secret: TypeSafe API key. Leave empty here; set it only in your local .env.
TYPESAFE_API_KEY=
# Optional: JEV endpoint (default https://api.typesafe.ai). https only (http allowed for localhost).
# TYPESAFE_BASE_URL=
# Pinned JEV model ID used for judging candidates.
JEV_MODEL=jev-1.13.0
# Judge mode profile (e.g. performance | economy).
JEV_MODE=performance
# Max tokens of retrieved context sent to the judge per request.
JEV_CONTEXT_BUDGET=48000
# Max tokens allotted to the JEV `state` payload.
JEV_STATE_BUDGET=28000
# Minimum relevance probability for a candidate to be kept.
JEV_RELEVANCE_THRESHOLD=0.78
# Relevance probability below which a candidate is flagged for review.
JEV_REVIEW_THRESHOLD=0.55
# Injection probability above which a candidate is quarantined.
JEV_INJECTION_THRESHOLD=0.80
# What to do with review-flagged candidates: keep | drop.
JEV_REVIEW_ACTION=keep
# Run a second judging pass over surviving candidates.
JEV_SECOND_PASS=false
# Ask the judge to check candidates for mutual contradictions.
JEV_CONTRADICTION_CHECK=false
# Behaviour when the judge is unreachable: fail_open | fail_closed.
JEV_FAILURE_MODE=fail_open
# Max concurrent in-flight requests to the JEV API.
JEV_MAX_CONCURRENT_REQUESTS=2
# Retries per JEV request before giving up.
JEV_MAX_RETRIES=2
# Per-request JEV HTTP timeout, in seconds.
JEV_TIMEOUT_S=30

# --- Retrieval / budgets ---
# Max candidate notes pulled from retrieval before filtering.
MAX_CANDIDATES=100
# Max tokens per emitted snippet.
SNIPPET_MAX_TOKENS=300
# Max snippets kept per source note after dedup.
DEDUP_MAX_PER_NOTE=1
# Total token budget of the context handed to the consumer model.
MODEL_CONTEXT_BUDGET=6000
# Max tokens any single source may contribute to the context.
PER_SOURCE_MAX_TOKENS=1500
# Deterministic top-K pre-filter before the paid judge (0 = disabled, judge everything).
# Zero tokens. With hybrid retrieval the correct note lands at position 0 in 9/10 questions,
# so 8 keeps a wide margin while cutting judge input ~85%.
PREFILTER_TOP_K=8
# Weight of the lexical (BM25) score relative to the graph score in the pre-filter.
PREFILTER_LEXICAL_WEIGHT=0.3
# Safety net: if the judge eliminates every candidate, return this many top retrieval
# candidates instead of an empty context (0 disables). Measured: prevented 3/10 empty answers.
JEV_MIN_SURVIVORS=3
# Hybrid Graphify retrieval: BM25 body text + graph edges. false = old CLI traversal.
GRAPHIFY_HYBRID=true
# Number of BM25 text hits used as graph traversal seeds.
GRAPHIFY_TEXT_SEEDS=10
# Number of extra nodes reached by expanding graph edges from the seeds.
GRAPHIFY_GRAPH_EXPAND=15
# Graphify executable name or path (must be on PATH if unqualified).
GRAPHIFY_BIN=graphify
# Token budget passed to `graphify query --budget`.
GRAPHIFY_QUERY_BUDGET=6000

# --- Consumers (optional; availability is detected at runtime) ---
# Secret: Anthropic API key. Leave empty unless using the Anthropic consumer.
ANTHROPIC_API_KEY=
# Secret: OpenAI API key. Leave empty unless using the OpenAI consumer.
OPENAI_API_KEY=
# Secret: OpenRouter API key. Leave empty unless using the OpenRouter consumer.
OPENROUTER_API_KEY=
# Base URL of a local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Base URL of a local vLLM OpenAI-compatible server.
VLLM_BASE_URL=http://localhost:8001/v1
# Base URL of any other OpenAI-compatible endpoint.
OPENAI_COMPAT_BASE_URL=
# Model name to request from that OpenAI-compatible endpoint.
OPENAI_COMPAT_MODEL=
# Secret: API key for that OpenAI-compatible endpoint, if it requires one.
OPENAI_COMPAT_API_KEY=
# Provider name passed to the Hermes consumer adapter.
HERMES_PROVIDER=
# Model name passed to the Hermes consumer adapter.
HERMES_MODEL=

# --- Runtime ---
# Runtime profile: production | development.
PROFILE=production
# Enable benchmark instrumentation and deterministic behaviour.
BENCHMARK_MODE=false
# Enable the retrieval/judge result cache.
CACHE_ENABLED=true
# RNG seed used when BENCHMARK_MODE is on.
BENCHMARK_SEED=42
# Interface the API server binds to. Loopback by default (§5.4 da proposta 2026-09-28): endpoints
# that change server state (feedback, benchmark run, /config/*) always refuse non-127.0.0.1/::1
# clients regardless of this value, so setting 0.0.0.0 only exposes the READ endpoints to the LAN.
# Legacy alias HOST is still read if MG_HOST is unset.
MG_HOST=127.0.0.1
# Port the API server listens on.
PORT=8000
# Local write-protection token (§5.4, §3): generated on first start and written HERE automatically.
# Never set this by hand and never share it; every write endpoint requires it in the X-MG-Token
# header. Leave empty -- the server fills it in.
MG_LOCAL_TOKEN=

# --- Memory Optimization Layer (runs on EVERY search; zero tokens) ---
# Full reference: docs/OPTIMIZATION_LAYER.md. false = exact pre-layer behaviour.
MG_OPTIMIZER=true
# Pipeline chosen by pipeline="auto" per query class (baseline|graphify|graphify_jev|graphify_jev_opt).
MG_ROUTE_SIMPLE=baseline
MG_ROUTE_MEDIUM=baseline
MG_ROUTE_COMPLEX=baseline
MG_ROUTE_AMBIGUOUS=baseline
# Drop results scoring < RATIO x best (SIMPLE/MEDIUM only), never fewer than FLOOR. Calibrated knee.
MG_OPT_ADAPTIVE_CUT=true
MG_OPT_CUT_RATIO=0.5
MG_OPT_CUT_FLOOR=3
# Collapse near-duplicate notes in the final context.
MG_OPT_NEAR_DEDUP=true
MG_OPT_NEAR_DEDUP_THRESHOLD=0.88
# Omit the redundant section attribute on <note> blocks.
MG_OPT_COMPACT_HEADERS=true
# Mark (never alter) notes with strong instruction-override phrases.
MG_OPT_INJECTION_FLAG=true
# In-process result cache (production profile only).
MG_OPT_RESULT_CACHE=true
MG_OPT_CACHE_SIZE=256
MG_OPT_CACHE_TTL_S=900
# Seconds between vault change checks; the index rebuilds when notes change. -1 = never.
MG_VAULT_REFRESH_S=5
# MCP: minimal = one tool (memory_search); full = the 7 legacy tools.
MG_MCP_TOOLSET=minimal
# MCP: compact = context + run_id + cost metrics; full = adds sources and all metrics.
MG_MCP_RESPONSE=compact

# =====================================================================================================
# ANA-074 -- variáveis adicionais lidas pelo código. Tudo abaixo vem COMENTADO com o default do código
# (descomente só o que quiser mudar). Lista completa gerada do código: docs/ENVIRONMENT_REFERENCE.md
# (scripts/gen_config_reference.py; tests/test_docs_env.py falha se algo aqui/lá divergir).
# Marcação: [user] = você pode definir | [interna] = o Gateway define sozinho (NÃO defina) |
#           [dev] = ferramentas de desenvolvimento/benchmark.
# =====================================================================================================

# --- Onde mora o estado gravável ---
# [user] Raiz dos dados (.env, benchmark.db, logs/, data/, local_settings.json). Vence qualquer outro critério.
# Sem ela: checkout git = raiz do repo; pacote instalado = diretório de dados da plataforma.
# ANAMNESIA_HOME=
# [user] Caminho do SQLite de métricas e do arquivo de perguntas do benchmark (default: <raiz dos dados>).
# DB_PATH=
# BENCHMARK_QUESTIONS=
# [user] Comprime runs.context com zlib ao gravar (ferramentas que leem o SQLite direto veriam base64).
# DB_COMPRESS_CONTEXT=false

# --- Rede / segurança da API (ver docs/guides/SECURITY.md e SECURITY.md) ---
# [user] Alias legado de MG_HOST (só é lido se MG_HOST estiver vazio). Prefira MG_HOST.
# HOST=127.0.0.1
# [user] Hosts extras aceitos no cabeçalho Host (proteção contra DNS rebinding), separados por vírgula.
# MG_ALLOWED_HOSTS=
# [user] Limite do corpo de requisição / de uploads, em bytes (default no código: 262144 e 1048576).
# MG_MAX_BODY_BYTES=262144
# MG_MAX_UPLOAD_BYTES=1048576
# [user] Requisições por minuto nas rotas de busca/geração/benchmark (0 = sem limite; default 600).
# MG_RATE_LIMIT_PER_MIN=600
# [user] Redação de caminhos absolutos nas respostas: lan (padrão, só clientes não-loopback) | always | never.
# MG_REDACT_PATHS=lan
# [user] Filtros de redação no log de acesso e caminhos nos logs (1 = ligado; 0/off desliga).
# MG_LOG_REDACT=1
# [user] Guarda de URL dos providers: enforce (padrão) | warn | off. Hosts não-loopback exigem a flag abaixo.
# MG_PROVIDER_URL_GUARD=enforce
# MG_ALLOW_REMOTE_PROVIDERS=
# [user] Backend dos segredos de modelos: vazio = .env (padrão) | keyring.
# MG_SECRETS_BACKEND=
# [user] Permite o botão "testar conexão" fazer chamadas de rede reais (1). Padrão: teste estrutural offline.
# ANAMNESIA_ALLOW_NETWORK_TEST=
# [user] Purga no start o texto de contexto dos runs mais velhos que N dias (0 = desligado).
# ANAMNESIA_CONTEXT_TTL_DAYS=0
# [user] Grava só hash + fontes, nunca o texto do contexto entregue (1 liga). MG_METRICS_ONLY faz o mesmo nas rotas de custo/contexto.
# ANAMNESIA_METRICS_ONLY=
# MG_METRICS_ONLY=
# [user] Nonce por contexto (delimitadores não adivinháveis) nos pipelines não congelados (1 liga).
# MG_CONTEXT_NONCE=0

# --- Terminais / PTY / projetos (ver docs/guides/TERMINALS.md) ---
# [user] Máximo de sessões PTY simultâneas (default 8).
# ANAMNESIA_MAX_SESSIONS=8
# [user] Limites do Job Object dos PTYs: on (padrão) | off. Ociosidade de agentes sem cliente, em segundos.
# MG_PTY_LIMITS=on
# MG_PTY_AGENT_IDLE_SECONDS=
# [user] 1 = não repassa HOME/USERPROFILE ao PTY.
# MG_PTY_NO_HOME=
# [user] Injeta o MCP do Gateway nos agentes dos terminais (1 = sim, padrão).
# MG_TERMINAL_MCP=1
# [user] Guarda de projetos e de execução: enforce (padrão) | warn | off. Allowlist extra de executáveis (vírgula).
# ANAMNESIA_PROJECT_GUARD=enforce
# ANAMNESIA_EXEC_GUARD=
# ANAMNESIA_EXEC_ALLOWLIST=
# [user] Raízes onde projetos podem ser registrados (separadas por os.pathsep ou vírgula).
# MG_PROJECT_ROOTS=
# [user] Fixa o escopo do MCP / caminho do projeto do agente (normalmente injetados pelo Gateway).
# MG_SCOPE=
# MG_PROJECT_PATH=
# [user] Gate do memory_save quando MG_SCOPE fixa o projeto: enforce (padrão) | off.
# ANAMNESIA_SAVE_GATE=enforce

# --- Memória salva por agentes (memory_save, opt-in) ---
# [user] Liga a tool MCP memory_save (1). Desligada por padrão.
# MG_MCP_SAVE=0
# Tool MCP read-only `decision_status` (Decision Engine, ANAM-043); desligada por padrão (+1 schema por turno).
# MG_MCP_DECISION=0
# [user] Limites: bytes por nota (default 65536) e notas por minuto (default 30).
# MG_SAVED_MAX_BYTES=65536
# MG_SAVED_RATE_PER_MIN=30
# [user] Chaves de rollback (1 = comportamento novo, padrão): esquema v2, lixeira ao apagar, backup no forget_all.
# MG_MEMORY_SCHEMA_V2=1
# MG_MEMORY_SOFT_DELETE=1
# MG_MEMORY_FORGET_BACKUP=1

# --- Roteamento de modelos / orquestração (flags desligadas por padrão) ---
# [user] Liga o router de modelos (1) e escolhe o preset (balanced padrão).
# ANAMNESIA_ROUTING=
# ANAMNESIA_ROUTING_PRESET=balanced
# [user] mode=answer exige JEV strict na recuperação (1).
# ANAMNESIA_ANSWER_REQUIRE_JEV_STRICT=
# [user] mode=delegate: liga (1), launcher, preset e perfil do orquestrador.
# ANAMNESIA_DELEGATE=
# ANAMNESIA_DELEGATE_LAUNCHER=
# ANAMNESIA_DELEGATE_PRESET=
# ANAMNESIA_DELEGATE_PROFILE=
# [interna] Exportadas pelo orquestrador ao subagente -- NÃO defina:
# ANAMNESIA_ROLE= / ANAMNESIA_STEP= / ANAMNESIA_STEP_DIR= / ANAMNESIA_MODEL_ID= / ANAMNESIA_MODEL=
# [interna] Exportadas pelo Gateway ao PTY -- NÃO defina:
# MEMORY_GATEWAY_URL= / MG_AGENT_ROLE= / MG_MCP_CONFIG= / MG_MCP_COMMAND= / MG_MCP_ARGS= / MG_MCP_URL= / MG_TERMINAL_SESSION=

# --- Providers e agentes (opcional) ---
# [user] Alias do endpoint do Ollama usado pelo teste de conexão (a config principal é OLLAMA_BASE_URL).
# OLLAMA_HOST=
# [user] Segredo: chave do vLLM, se o servidor exigir.
# VLLM_API_KEY=
# [user] Binários dos agentes (nome no PATH ou caminho).
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# HERMES_BIN=hermes
# OPENCODE_BIN=opencode
# [user] Orçamento de contexto do consumidor Claude e timeout do Graphify (s).
# CLAUDE_CONTEXT_BUDGET=6000
# GRAPHIFY_TIMEOUT_S=60
# GRAPHIFY_STALE_FALLBACK_S=0   # ANA-080: >0 => grafo desatualizado ha mais de N s => busca so BM25
# MG_INCREMENTAL_INDEX=0        # ANA-102: 1 = indice FTS5 incremental em disco (fora do vault)

# --- Retrieval: Personalized PageRank (experimental, desligado) ---
# PPR_ENABLED=false
# PPR_ALPHA=0.85
# PPR_ITERS=30
# PPR_TOP_N=15

# --- Camada de otimização: ajustes finos MG_OPT_* adicionais (defaults do código) ---
# MG_OPT_CONFLICT_CHECK=true
# MG_OPT_CONFLICT_DEMOTE=0.5
# MG_OPT_CONFLICT_OVERLAP=0.6
# MG_OPT_HEADER_SECTION_CHARS=60
# MG_OPT_HISTORICAL_DEMOTE=0.5
# MG_OPT_HISTORICAL_EXCLUDE=false
# MG_OPT_PROVENANCE=false
# MG_OPT_TEMPORAL_DEMOTE=true
# [user] Veredito por escopo (desligado): liga e limiares de tamanho de escopo.
# MG_VERDICT_ENABLED=false
# MG_VERDICT_SMALL_MAX=15
# MG_VERDICT_LARGE_MIN=50

# --- [dev] Estágios opcionais OPT_* (todos desligados/neutros por padrão; ver docs/guides/OPTIMIZATION_LAYER.md
#     e docs/reports/OPTIONAL_STAGES_BENCHMARK.md). Estágios com modelo exigem extras opcionais. ---
# OPT_ENABLED=false
# OPT_STAGES_PRESET=free
# OPT_ADAPTIVE_K=false
# OPT_ADAPTIVE_K_MAX=20
# OPT_CACHE_L2=true
# OPT_CACHE_L3_SHADOW=true
# OPT_CACHE_PROMOTE_L3=false
# OPT_CACHE_RANKING=false
# OPT_CACHE_SNIPPETS=false
# OPT_LAYERED_CACHE=false
# OPT_EARLY_STOPPING=false
# OPT_EARLY_STOP_MAX_ACCEPT_RANK=3
# OPT_EARLY_STOP_MIN_STRONG=1
# OPT_NEAR_DEDUP=false
# OPT_NEAR_DEDUP_HAMMING=12
# OPT_NEAR_DEDUP_THRESHOLD=0.88
# OPT_PROGRESSIVE_CONTEXT=false
# OPT_PROGRESSIVE_BAND=0.12
# OPT_PROGRESSIVE_FIRST_TOKENS=300
# OPT_PROGRESSIVE_SECOND_TOKENS=600
# OPT_QUERY_PROFILING=true
# OPT_RECORD_SHADOW=true
# OPT_SMART_SNIPPET=false
# OPT_SNIPPET_FOR_FROZEN=false
# OPT_SNIPPET_MIN_SAVING=40
# OPT_SNIPPET_TOKENS=300
# OPT_STRICT_GATING=false
# OPT_STRICT_GATE_RELEVANCE=true
# OPT_STRICT_LEXICAL_SCREEN=true
# OPT_ZERO_EVIDENCE_DROP=false
# OPT_ZERO_EVIDENCE_SHADOW=true
# OPT_STAGE_BGE_RERANKER_V2_M3=false
# OPT_STAGE_MXBAI_RERANK_BASE_V2=false
# OPT_STAGE_RERANK_CACHE=true
# OPT_STAGE_RERANK_MAX_LENGTH=1024
# OPT_STAGE_LLMLINGUA2=false
# OPT_STAGE_LLMLINGUA2_RATE=0.5
# OPT_STAGE_PROVENCE=false
# OPT_STAGE_PROVENCE_THRESHOLD=0.05
# OPT_STAGE_SENTENCE_DEDUP_MMR=false
# OPT_STAGE_SENTENCE_DEDUP_MMR_LAMBDA=0.5
# OPT_STAGE_SENTENCE_DEDUP_MMR_THRESHOLD=0.85
# OPT_STAGE_SPOTLIGHT_NONCE=false
# OPT_STAGE_SPOTLIGHT_NONCE_MODE=random
# OPT_STAGE_SPOTLIGHT_NONCE_SECRET=

# --- Variáveis adicionais (ANAM-023): todas opcionais, comentadas, sem segredos ---
# Permite terminais PTY via WebSocket vindos de clientes não-loopback (padrão: bloqueado).
# ANAMNESIA_ALLOW_REMOTE_TERMINALS=0
# Aviso de orçamento (modo warn): ligado por padrão; 0/off silencia.
# ANAMNESIA_BUDGET_WARN=1
# Flag opt-in do circuit breaker de roteamento (abre após falhas de timeout/rate_limit/provider_down/auth).
# ANAMNESIA_CIRCUIT_BREAKER=0
# Opt-in: gate de diff na orquestração (1/true/on/yes).
# ANAMNESIA_DIFF_GATE=0
# Lista separada por vírgula de caminhos permitidos pelo diff gate.
# ANAMNESIA_DIFF_GATE_SCOPE=
# Hosts adicionais permitidos na allow-list de egress (separados por vírgula).
# ANAMNESIA_EGRESS_ALLOW_HOSTS=
# Opt-in: aplica enforcement de papéis na orquestração (1/true/on/yes).
# ANAMNESIA_ENFORCE_ROLES=0
# Flag opt-in: fallback de modelo escolhido pela causa da falha.
# ANAMNESIA_FALLBACK_BY_CAUSE=0
# Opt-in: handoff entre etapas da orquestração (1/true/on/yes).
# ANAMNESIA_HANDOFF=0
# Modo offline: bloqueia chamadas externas (1/true/yes/on). Alias: OFFLINE.
# ANAMNESIA_OFFLINE=0
# Alias de ANAMNESIA_OFFLINE (modo offline).
# OFFLINE=0
# Kill-switch de chamadas pagas: 0/off/false bloqueia provedores pagos.
# ANAMNESIA_PAID_CALLS=1
# Modo do motor de políticas (vazio/0/off = desligado).
# ANAMNESIA_POLICY=
# Caminho do arquivo de auditoria do motor de políticas.
# ANAMNESIA_POLICY_AUDIT=
# Caminho de um policy.yaml alternativo (padrão: config/policy.yaml).
# ANAMNESIA_POLICY_FILE=
# Flag opt-in de retry para falhas timeout/rate_limit/provider_down.
# ANAMNESIA_RETRY=0
# Flag opt-in do teste A/B de roteamento (braços A/B).
# ANAMNESIA_ROUTING_AB=0
# Flag opt-in do roteamento em sombra (shadow).
# ANAMNESIA_ROUTING_SHADOW=0
# Nome do preset alternativo usado pelo roteamento em sombra.
# ANAMNESIA_ROUTING_SHADOW_PRESET=
# Dias de retenção do texto das execuções no banco (padrão 30).
# ANAMNESIA_RUNS_TEXT_RETENTION_DAYS=30
# Orçamento total de tokens do plano de contexto por execução (limitado a [MIN, MAX]).
# ANAMNESIA_RUN_CONTEXT_BUDGET=
# Calibração de estimativa de tokens (opt-in; vazio = desligado).
# ANAMNESIA_TOKEN_CALIBRATION=
# Perfil de ferramentas MCP: restricted|readonly oculta ferramentas fora do perfil (vazio = todas).
# ANAMNESIA_TOOL_PROFILE=
# URL base alternativa da API Anthropic (padrão https://api.anthropic.com; passa pelo egress guard).
# ANTHROPIC_BASE_URL=
# Backend do JEV: typesafe (padrão) ou local.
# JEV_BACKEND=typesafe
# Host do modelo local do JEV (Ollama).
# JEV_LOCAL_HOST=http://127.0.0.1:11434
# Modelo local do JEV.
# JEV_LOCAL_MODEL=qwen3:8b
# Experimento de recuperação: peso da seção no BM25 (vazio = desligado).
# MG_EXP_BM25_SECTION_WEIGHT=
# Experimento de recuperação: ajusta candidatos ao orçamento.
# MG_EXP_BUDGET_FIT=false
# Experimento de recuperação: máximo de deduplicação complexa (0 = desligado).
# MG_EXP_COMPLEX_DEDUP_MAX=0
# Experimento de recuperação: modo do score híbrido (rank).
# MG_EXP_HYBRID_SCORE=rank
# Experimento de recuperação: alpha do rerank lexical.
# MG_EXP_LEX_RERANK_ALPHA=0.5
# Experimento de recuperação: top-N do rerank lexical (0 = desligado).
# MG_EXP_LEX_RERANK_TOP=0
# Experimento de recuperação: tamanho mínimo de prefixo (0 = desligado).
# MG_EXP_PREFIX_MIN_LEN=0
# Experimento de recuperação: reescrita de consulta.
# MG_EXP_QUERY_REWRITE=false
# Experimento de recuperação: corte de relevância (0.0 = desligado).
# MG_EXP_REL_CUTOFF=0.0
# Experimento de recuperação: peso do grafo no RRF.
# MG_EXP_RRF_GRAPH_WEIGHT=0.5
# Experimento de recuperação: constante k do RRF.
# MG_EXP_RRF_K=60
# Experimento de recuperação: aplica escopo antes do top-N.
# MG_EXP_SCOPE_BEFORE_TOPN=false
# Experimento de recuperação: modelo de embeddings semânticos.
# MG_EXP_SEMANTIC_MODEL=nomic-embed-text
# Experimento de recuperação: fusão semântica via RRF.
# MG_EXP_SEMANTIC_RRF=false
# Experimento de recuperação: stemming por prefixo.
# MG_EXP_STEM_PREFIX=false
# Experimento de recuperação: contagem unificada de tokens.
# MG_EXP_UNIFIED_TOKENS=false
# URL do bridge MCP -> REST (opt-in; vazio = desligado).
# MG_MCP_BRIDGE_URL=
# Expõe recursos MCP (opt-in).
# MG_MCP_RESOURCES=0
# Token do bridge MCP -> REST (preencha localmente; nunca commite).
# MG_MCP_TOKEN=
# Modo de deduplicação ao gravar memória: off|warn|skip|update.
# MG_MEMORY_DEDUPE=warn
# Exclui memórias expiradas da recuperação (0/off desliga).
# MG_MEMORY_EXPIRED_EXCLUDE=1
# Dias que memórias expiradas ficam na lixeira antes da remoção.
# MG_MEMORY_TRASH_DAYS=30
# Modo de proveniência no contexto: full (padrão) ou compact.
# MG_OPT_PROVENANCE_MODE=full
# Timeout (s) do lock entre processos do memory store.
# MG_STORE_LOCK_TIMEOUT_S=30

# --- Laya (decisor local não generativo, ANAM-042) ---
# Modo do decisor Laya: auto|inproc|serve|off (auto = inproc se 'laya' importável, senão serve, senão off explícito).
MG_LAYA_MODE=auto
# Diretório base dos pesos do Laya (fora do Git).
# MG_LAYA_MODELS_DIR=data/local_ai/models
# Diretório do checkpoint laya-multilingual (vazio = <MODELS_DIR>/laya-multilingual).
# MG_LAYA_MULTILINGUAL_DIR=
# Diretório do checkpoint inglês convaiinnovations/laya (vazio = <MODELS_DIR>/laya-english).
# MG_LAYA_ENGLISH_DIR=
# URL loopback do laya-serve (modo serve; nunca a porta 8000 do Gateway).
# MG_LAYA_SERVE_URL=http://127.0.0.1:8765
# Timeout (s) das chamadas HTTP ao laya-serve.
# MG_LAYA_TIMEOUT_S=20
# Dispositivo do torch para o Laya in-process.
# MG_LAYA_DEVICE=cpu
# Threads intra-op do torch (0 = padrão).
# MG_LAYA_THREADS=0
# Tamanho de lote do predict_batch.
# MG_LAYA_BATCH_SIZE=16
# Máximo de caracteres do snippet enviado ao Laya.
# MG_LAYA_MAX_STATE_CHARS=1500
# Força um checkpoint (multilingual evita carregar o inglês, ~0,8 GB a menos de RAM); vazio = por idioma.
# MG_LAYA_FORCE_MODEL=
# Relevância >= limiar => KEEP (limiar experimental, ver docs/bench/anam-042-laya.md).
# MG_LAYA_KEEP_THRESHOLD=0.25
# Relevância < limiar => DROP; entre os dois => REVIEW/escalona ao JEV na cascata.
# MG_LAYA_DROP_THRESHOLD=0.10
# Cascata: confidence do Laya abaixo disto escalona o candidato ao JEV.
# MG_LAYA_MIN_CONFIDENCE=0.0
# Temperatura de calibração (refit por dados próprios; 1.0 = sem refit).
# MG_LAYA_TEMPERATURE=1.0
# Arquivo opcional de calibração (reservado; vazio = usa MG_LAYA_TEMPERATURE).
# MG_LAYA_CALIBRATION_FILE=
# Laya indisponível no filtro: fail_open (passa SINALIZADO) ou fail_closed (nada passa).
# MG_LAYA_FAILURE_MODE=fail_open
# Limiar do classificador de privacidade (>= => só provider local).
# MG_LAYA_PRIVACY_THRESHOLD=0.10
# Laya ligado mas caiu: fail_closed (trata como privado) ou rules_only.
# MG_LAYA_PRIVACY_FAILURE=fail_closed
# Limiar de injeção/lixo do Laya (sinal adicional ao injection_screen).
# MG_LAYA_INJECTION_THRESHOLD=0.90
# Triagem Laya na escrita de memória: off|warn|block.
# MG_LAYA_WRITE_TRIAGE=off

# --- Operação e IA local (ANAM-013/033/034/035) ---
# Orçamento: 1 faz o guard degradar plano pago para baseline quando estoura (padrão: não impõe).
# ANAMNESIA_BUDGET_ENFORCE=0
# Persistência assíncrona das runs do Gateway (1 liga) e tamanho máximo da fila.
# ANAMNESIA_GATEWAY_ASYNC_PERSIST=
# ANAMNESIA_PERSIST_MAX_QUEUE=1000
# Tabela de preços própria (JSON) em vez da embutida.
# ANAMNESIA_PRICING_FILE=
# Requisições sem identidade de escopo: deny (padrão) | ignore | allow.
# ANAMNESIA_SCOPE_ANON=deny
# Ollama: keep_alive e janela de contexto (num_ctx) enviados às chamadas.
# ANAMNESIA_OLLAMA_KEEP_ALIVE=
# ANAMNESIA_OLLAMA_NUM_CTX=
# Chave do servidor Colibri local: o Gateway a passa por ambiente (não por --api-key).
# COLI_API_KEY=
# Pasta de setup do Colibri (setup.json) e raiz de instalação para descoberta.
# COLI_SETUP_HOME=
# MG_COLIBRI_HOME=
# Hot set de notas recentes no otimizador: liga, meia-vida (s) e tamanho.
# MG_HOTSET=
# MG_HOTSET_HALFLIFE_S=3600
# MG_HOTSET_TOPN=16
# Hosts extras permitidos no download de modelos locais (separados por vírgula).
# MG_LOCAL_AI_DL_HOSTS=
# Política de licença de modelos locais: comercial (padrão, restritivo) | pessoal.
# MG_LOCAL_AI_MODE=comercial
# Ranking de notas salvas: v1 (padrão, só relevância) | v2 (composto + registro de uso).
# MG_MEMORY_RANK=v1
# Deduplicação quase-duplicada via LSH (1/0).
# MG_NEAR_DUP_LSH=
# Classificador de privacidade no mode=answer: rules (padrão) | laya | off. Privado => só modelo local.
# MG_PRIVACY_CLASSIFY=rules
# Base URL OpenAI-compatível usada pelo benchmark local (padrão http://localhost:11434/v1).
# OPENAI_BASE_URL=
# Chave opcional para o backend JEV local (loopback); TYPESAFE_API_KEY é dispensada nesse caso.
# TYPESAFE_LOCAL_API_KEY=

# --- Anamnésia Decision Engine (ANAM-043; EXPERIMENTAL; padrão = JEV-only) ---
# Provider de decisão: jev (padrão) | laya | hybrid | adaptive. Laya NÃO superou o lexical no corpus sintético (docs/bench/decision-engine.md).
# MG_DECISION_PROVIDER=jev
# Estratégia do hybrid: laya_then_jev | jev_then_laya | ensemble.
# MG_DECISION_STRATEGY=laya_then_jev
# Preset EXPERIMENTAL só de configuração: fast | balanced | quality (vazio = nenhum).
# MG_DECISION_PRESET=
# JSON com limiares por provider e por projeto (isolados): {"thresholds": {...}, "projects": {"slug": {...}}}.
# MG_DECISION_CONFIG_FILE=
# Entradas do cache de decisões em memória (0 = desliga).
# MG_DECISION_CACHE_SIZE=2048
# Registros do histórico em memória (somente IDs/hashes).
# MG_DECISION_HISTORY_SIZE=500
# Persistir histórico (IDs/hashes) em logs/decision_history.jsonl (1/0).
# MG_DECISION_HISTORY_PERSIST=1
