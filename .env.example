# Copy to .env and fill. Never commit .env. Only variables actually read by the code are listed.

# --- Vault (READ ONLY) ---
OBSIDIAN_VAULT_PATH=C:\Users\fonse\Cérebro_AI

# --- JEV / TypeSafe (typesafe-sdk reads TYPESAFE_API_KEY itself) ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_MODE=performance
JEV_CONTEXT_BUDGET=48000
JEV_STATE_BUDGET=28000
JEV_RELEVANCE_THRESHOLD=0.78
JEV_REVIEW_THRESHOLD=0.55
JEV_INJECTION_THRESHOLD=0.80
JEV_REVIEW_ACTION=keep
JEV_SECOND_PASS=false
JEV_CONTRADICTION_CHECK=false
JEV_FAILURE_MODE=fail_open
JEV_MAX_CONCURRENT_REQUESTS=2
JEV_MAX_RETRIES=2
JEV_TIMEOUT_S=30

# --- Retrieval / budgets ---
MAX_CANDIDATES=100
SNIPPET_MAX_TOKENS=300
DEDUP_MAX_PER_NOTE=1
MODEL_CONTEXT_BUDGET=6000
PER_SOURCE_MAX_TOKENS=1500
GRAPHIFY_BIN=graphify
GRAPHIFY_QUERY_BUDGET=6000

# --- Consumers (optional; availability is detected at runtime) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
HERMES_PROVIDER=
HERMES_MODEL=

# --- Runtime ---
PROFILE=production
BENCHMARK_MODE=false
CACHE_ENABLED=true
BENCHMARK_SEED=42
HOST=0.0.0.0
PORT=8000
