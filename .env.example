# OPT_EARLY_STOP_MIN_STRONG=1
# OPT_NEAR_DEDUP=false
# OPT_NEAR_DEDUP_HAMMING=12
# OPT_NEAR_DEDUP_THRESHOLD=0.88
# OPT_PROGRESSIVE_CONTEXT=false
# OPT_PROGRESSIVE_BAND=0.12
# OPT_PROGRESSIVE_FIRST_TOKENS=300
# OPT_PROGRESSIVE_SECOND_TOKENS=600
# OPT_QUERY_PROFILING=true
# OPT_RECORD_SHADOW=true
# OPT_SMART_SNIPPET=false
# OPT_SNIPPET_FOR_FROZEN=false
# OPT_SNIPPET_MIN_SAVING=40
# OPT_SNIPPET_TOKENS=300
# OPT_STRICT_GATING=false
# OPT_STRICT_GATE_RELEVANCE=true
# OPT_STRICT_LEXICAL_SCREEN=true
# OPT_ZERO_EVIDENCE_DROP=false
# OPT_ZERO_EVIDENCE_SHADOW=true
# OPT_STAGE_BGE_RERANKER_V2_M3=false
# OPT_STAGE_MXBAI_RERANK_BASE_V2=false
# OPT_STAGE_RERANK_CACHE=true
# OPT_STAGE_RERANK_MAX_LENGTH=1024
# OPT_STAGE_LLMLINGUA2=false
# OPT_STAGE_LLMLINGUA2_RATE=0.5
# OPT_STAGE_PROVENCE=false
# OPT_STAGE_PROVENCE_THRESHOLD=0.05
# OPT_STAGE_SENTENCE_DEDUP_MMR=false
# OPT_STAGE_SENTENCE_DEDUP_MMR_LAMBDA=0.5
# OPT_STAGE_SENTENCE_DEDUP_MMR_THRESHOLD=0.85
# OPT_STAGE_SPOTLIGHT_NONCE=false
# OPT_STAGE_SPOTLIGHT_NONCE_MODE=random
# OPT_STAGE_SPOTLIGHT_NONCE_SECRET=
