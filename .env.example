#     e docs/reports/OPTIONAL_STAGES_BENCHMARK.md). Estágios com modelo exigem extras opcionais. ---
# OPT_ENABLED=false
# OPT_STAGES_PRESET=free
# OPT_ADAPTIVE_K=false
