# Copy to .env and fill. Never commit .env. Only variables actually read by the code are listed.

# --- Vault (READ ONLY) ---
# Absolute or relative path to the Obsidian-style vault the Gateway reads notes from.
# Resolution precedence (see config/retrieval.py: resolve_vault_path):
#   1. explicit --vault argument
#   2. MEMORY_GATEWAY_VAULT (canonical)
#   3. OBSIDIAN_VAULT_PATH (legacy alias, still supported)
#   4. bundled example corpus ./data/synthetic_vault
MEMORY_GATEWAY_VAULT=./data/synthetic_vault
# Linux/macOS example:   MEMORY_GATEWAY_VAULT=/home/user/notes
# Windows example:       MEMORY_GATEWAY_VAULT=C:/Users/YourUser/Documents/MyVault
# Legacy alias, kept for backwards compatibility. Prefer MEMORY_GATEWAY_VAULT.
# OBSIDIAN_VAULT_PATH=

# --- JEV / TypeSafe (typesafe-sdk reads TYPESAFE_API_KEY itself) ---
# Secret: TypeSafe API key. Leave empty here; set it only in your local .env.
TYPESAFE_API_KEY=
# Pinned JEV model ID used for judging candidates.
JEV_MODEL=jev-1.13.0
# Judge mode profile (e.g. performance | economy).
JEV_MODE=performance
# Max tokens of retrieved context sent to the judge per request.
JEV_CONTEXT_BUDGET=48000
# Max tokens allotted to the JEV `state` payload.
JEV_STATE_BUDGET=28000
# Minimum relevance probability for a candidate to be kept.
JEV_RELEVANCE_THRESHOLD=0.78
# Relevance probability below which a candidate is flagged for review.
JEV_REVIEW_THRESHOLD=0.55
# Injection probability above which a candidate is quarantined.
JEV_INJECTION_THRESHOLD=0.80
# What to do with review-flagged candidates: keep | drop.
JEV_REVIEW_ACTION=keep
# Run a second judging pass over surviving candidates.
JEV_SECOND_PASS=false
# Ask the judge to check candidates for mutual contradictions.
JEV_CONTRADICTION_CHECK=false
# Behaviour when the judge is unreachable: fail_open | fail_closed.
JEV_FAILURE_MODE=fail_open
# Max concurrent in-flight requests to the JEV API.
JEV_MAX_CONCURRENT_REQUESTS=2
# Retries per JEV request before giving up.
JEV_MAX_RETRIES=2
# Per-request JEV HTTP timeout, in seconds.
JEV_TIMEOUT_S=30

# --- Retrieval / budgets ---
# Max candidate notes pulled from retrieval before filtering.
MAX_CANDIDATES=100
# Max tokens per emitted snippet.
SNIPPET_MAX_TOKENS=300
# Max snippets kept per source note after dedup.
DEDUP_MAX_PER_NOTE=1
# Total token budget of the context handed to the consumer model.
MODEL_CONTEXT_BUDGET=6000
# Max tokens any single source may contribute to the context.
PER_SOURCE_MAX_TOKENS=1500
# Deterministic top-K pre-filter before the paid judge (0 = disabled, judge everything).
# Zero tokens. With hybrid retrieval the correct note lands at position 0 in 9/10 questions,
# so 8 keeps a wide margin while cutting judge input ~85%.
PREFILTER_TOP_K=8
# Weight of the lexical (BM25) score relative to the graph score in the pre-filter.
PREFILTER_LEXICAL_WEIGHT=0.3
# Safety net: if the judge eliminates every candidate, return this many top retrieval
# candidates instead of an empty context (0 disables). Measured: prevented 3/10 empty answers.
JEV_MIN_SURVIVORS=3
# Hybrid Graphify retrieval: BM25 body text + graph edges. false = old CLI traversal.
GRAPHIFY_HYBRID=true
# Number of BM25 text hits used as graph traversal seeds.
GRAPHIFY_TEXT_SEEDS=10
# Number of extra nodes reached by expanding graph edges from the seeds.
GRAPHIFY_GRAPH_EXPAND=15
# Graphify executable name or path (must be on PATH if unqualified).
GRAPHIFY_BIN=graphify
# Token budget passed to `graphify query --budget`.
GRAPHIFY_QUERY_BUDGET=6000

# --- Consumers (optional; availability is detected at runtime) ---
# Secret: Anthropic API key. Leave empty unless using the Anthropic consumer.
ANTHROPIC_API_KEY=
# Secret: OpenAI API key. Leave empty unless using the OpenAI consumer.
OPENAI_API_KEY=
# Secret: OpenRouter API key. Leave empty unless using the OpenRouter consumer.
OPENROUTER_API_KEY=
# Base URL of a local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Base URL of a local vLLM OpenAI-compatible server.
VLLM_BASE_URL=http://localhost:8001/v1
# Base URL of any other OpenAI-compatible endpoint.
OPENAI_COMPAT_BASE_URL=
# Model name to request from that OpenAI-compatible endpoint.
OPENAI_COMPAT_MODEL=
# Secret: API key for that OpenAI-compatible endpoint, if it requires one.
OPENAI_COMPAT_API_KEY=
# Provider name passed to the Hermes consumer adapter.
HERMES_PROVIDER=
# Model name passed to the Hermes consumer adapter.
HERMES_MODEL=

# --- Runtime ---
# Runtime profile: production | development.
PROFILE=production
# Enable benchmark instrumentation and deterministic behaviour.
BENCHMARK_MODE=false
# Enable the retrieval/judge result cache.
CACHE_ENABLED=true
# RNG seed used when BENCHMARK_MODE is on.
BENCHMARK_SEED=42
# Interface the API server binds to. Loopback by default (§5.4 da proposta 2026-09-28): endpoints
# that change server state (feedback, benchmark run, /config/*) always refuse non-127.0.0.1/::1
# clients regardless of this value, so setting 0.0.0.0 only exposes the READ endpoints to the LAN.
# Legacy alias HOST is still read if MG_HOST is unset.
MG_HOST=127.0.0.1
# Port the API server listens on.
PORT=8000
# Local write-protection token (§5.4, §3): generated on first start and written HERE automatically.
# Never set this by hand and never share it; every write endpoint requires it in the X-MG-Token
# header. Leave empty -- the server fills it in.
MG_LOCAL_TOKEN=

# --- Memory Optimization Layer (runs on EVERY search; zero tokens) ---
# Full reference: docs/OPTIMIZATION_LAYER.md. false = exact pre-layer behaviour.
MG_OPTIMIZER=true
# Pipeline chosen by pipeline="auto" per query class (baseline|graphify|graphify_jev|graphify_jev_opt).
MG_ROUTE_SIMPLE=baseline
MG_ROUTE_MEDIUM=baseline
MG_ROUTE_COMPLEX=baseline
MG_ROUTE_AMBIGUOUS=baseline
# Drop results scoring < RATIO x best (SIMPLE/MEDIUM only), never fewer than FLOOR. Calibrated knee.
MG_OPT_ADAPTIVE_CUT=true
MG_OPT_CUT_RATIO=0.5
MG_OPT_CUT_FLOOR=3
# Collapse near-duplicate notes in the final context.
MG_OPT_NEAR_DEDUP=true
MG_OPT_NEAR_DEDUP_THRESHOLD=0.88
# Omit the redundant section attribute on <note> blocks.
MG_OPT_COMPACT_HEADERS=true
# Mark (never alter) notes with strong instruction-override phrases.
MG_OPT_INJECTION_FLAG=true
# In-process result cache (production profile only).
MG_OPT_RESULT_CACHE=true
MG_OPT_CACHE_SIZE=256
MG_OPT_CACHE_TTL_S=900
# Seconds between vault change checks; the index rebuilds when notes change. -1 = never.
MG_VAULT_REFRESH_S=5
# MCP: minimal = one tool (memory_search); full = the 7 legacy tools.
MG_MCP_TOOLSET=minimal
# MCP: compact = context + run_id + cost metrics; full = adds sources and all metrics.
MG_MCP_RESPONSE=compact

# =====================================================================================================
# ANA-074 -- variáveis adicionais lidas pelo código. Tudo abaixo vem COMENTADO com o default do código
# (descomente só o que quiser mudar). Lista completa gerada do código: docs/ENVIRONMENT_REFERENCE.md
# (scripts/gen_config_reference.py; tests/test_docs_env.py falha se algo aqui/lá divergir).
# Marcação: [user] = você pode definir | [interna] = o Gateway define sozinho (NÃO defina) |
#           [dev] = ferramentas de desenvolvimento/benchmark.
# =====================================================================================================

# --- Onde mora o estado gravável ---
# [user] Raiz dos dados (.env, benchmark.db, logs/, data/, local_settings.json). Vence qualquer outro critério.
# Sem ela: checkout git = raiz do repo; pacote instalado = diretório de dados da plataforma.
# ANAMNESIA_HOME=
# [user] Caminho do SQLite de métricas e do arquivo de perguntas do benchmark (default: <raiz dos dados>).
# DB_PATH=
# BENCHMARK_QUESTIONS=
# [user] Comprime runs.context com zlib ao gravar (ferramentas que leem o SQLite direto veriam base64).
# DB_COMPRESS_CONTEXT=false

# --- Rede / segurança da API (ver docs/guides/SECURITY.md e SECURITY.md) ---
# [user] Alias legado de MG_HOST (só é lido se MG_HOST estiver vazio). Prefira MG_HOST.
# HOST=127.0.0.1
# [user] Hosts extras aceitos no cabeçalho Host (proteção contra DNS rebinding), separados por vírgula.
# MG_ALLOWED_HOSTS=
# [user] Limite do corpo de requisição / de uploads, em bytes (default no código: 262144 e 1048576).
# MG_MAX_BODY_BYTES=262144
# MG_MAX_UPLOAD_BYTES=1048576
# [user] Requisições por minuto nas rotas de busca/geração/benchmark (0 = sem limite; default 600).
# MG_RATE_LIMIT_PER_MIN=600
# [user] Redação de caminhos absolutos nas respostas: lan (padrão, só clientes não-loopback) | always | never.
# MG_REDACT_PATHS=lan
# [user] Filtros de redação no log de acesso e caminhos nos logs (1 = ligado; 0/off desliga).
# MG_LOG_REDACT=1
# [user] Guarda de URL dos providers: enforce (padrão) | warn | off. Hosts não-loopback exigem a flag abaixo.
# MG_PROVIDER_URL_GUARD=enforce
# MG_ALLOW_REMOTE_PROVIDERS=
# [user] Backend dos segredos de modelos: vazio = .env (padrão) | keyring.
# MG_SECRETS_BACKEND=
# [user] Permite o botão "testar conexão" fazer chamadas de rede reais (1). Padrão: teste estrutural offline.
# ANAMNESIA_ALLOW_NETWORK_TEST=
# [user] Purga no start o texto de contexto dos runs mais velhos que N dias (0 = desligado).
# ANAMNESIA_CONTEXT_TTL_DAYS=0
# [user] Grava só hash + fontes, nunca o texto do contexto entregue (1 liga). MG_METRICS_ONLY faz o mesmo nas rotas de custo/contexto.
# ANAMNESIA_METRICS_ONLY=
# MG_METRICS_ONLY=
# [user] Nonce por contexto (delimitadores não adivinháveis) nos pipelines não congelados (1 liga).
# MG_CONTEXT_NONCE=0

# --- Terminais / PTY / projetos (ver docs/guides/TERMINALS.md) ---
# [user] Máximo de sessões PTY simultâneas (default 8).
# ANAMNESIA_MAX_SESSIONS=8
# [user] Limites do Job Object dos PTYs: on (padrão) | off. Ociosidade de agentes sem cliente, em segundos.
# MG_PTY_LIMITS=on
# MG_PTY_AGENT_IDLE_SECONDS=
# [user] 1 = não repassa HOME/USERPROFILE ao PTY.
# MG_PTY_NO_HOME=
# [user] Injeta o MCP do Gateway nos agentes dos terminais (1 = sim, padrão).
# MG_TERMINAL_MCP=1
# [user] Guarda de projetos e de execução: enforce (padrão) | warn | off. Allowlist extra de executáveis (vírgula).
# ANAMNESIA_PROJECT_GUARD=enforce
# ANAMNESIA_EXEC_GUARD=
# ANAMNESIA_EXEC_ALLOWLIST=
# [user] Raízes onde projetos podem ser registrados (separadas por os.pathsep ou vírgula).
# MG_PROJECT_ROOTS=
# [user] Fixa o escopo do MCP / caminho do projeto do agente (normalmente injetados pelo Gateway).
# MG_SCOPE=
# MG_PROJECT_PATH=
# [user] Gate do memory_save quando MG_SCOPE fixa o projeto: enforce (padrão) | off.
# ANAMNESIA_SAVE_GATE=enforce

# --- Memória salva por agentes (memory_save, opt-in) ---
# [user] Liga a tool MCP memory_save (1). Desligada por padrão.
# MG_MCP_SAVE=0
# [user] Limites: bytes por nota (default 65536) e notas por minuto (default 30).
# MG_SAVED_MAX_BYTES=65536
# MG_SAVED_RATE_PER_MIN=30
# [user] Chaves de rollback (1 = comportamento novo, padrão): esquema v2, lixeira ao apagar, backup no forget_all.
# MG_MEMORY_SCHEMA_V2=1
# MG_MEMORY_SOFT_DELETE=1
# MG_MEMORY_FORGET_BACKUP=1

# --- Roteamento de modelos / orquestração (flags desligadas por padrão) ---
# [user] Liga o router de modelos (1) e escolhe o preset (balanced padrão).
# ANAMNESIA_ROUTING=
# ANAMNESIA_ROUTING_PRESET=balanced
# [user] mode=answer exige JEV strict na recuperação (1).
# ANAMNESIA_ANSWER_REQUIRE_JEV_STRICT=
# [user] mode=delegate: liga (1), launcher, preset e perfil do orquestrador.
# ANAMNESIA_DELEGATE=
# ANAMNESIA_DELEGATE_LAUNCHER=
# ANAMNESIA_DELEGATE_PRESET=
# ANAMNESIA_DELEGATE_PROFILE=
# [interna] Exportadas pelo orquestrador ao subagente -- NÃO defina:
# ANAMNESIA_ROLE= / ANAMNESIA_STEP= / ANAMNESIA_STEP_DIR= / ANAMNESIA_MODEL_ID= / ANAMNESIA_MODEL=
# [interna] Exportadas pelo Gateway ao PTY -- NÃO defina:
# MEMORY_GATEWAY_URL= / MG_AGENT_ROLE= / MG_MCP_CONFIG= / MG_MCP_COMMAND= / MG_MCP_ARGS= / MG_MCP_URL= / MG_TERMINAL_SESSION=

# --- Providers e agentes (opcional) ---
# [user] Alias do endpoint do Ollama usado pelo teste de conexão (a config principal é OLLAMA_BASE_URL).
# OLLAMA_HOST=
# [user] Segredo: chave do vLLM, se o servidor exigir.
# VLLM_API_KEY=
# [user] Binários dos agentes (nome no PATH ou caminho).
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# HERMES_BIN=hermes
# OPENCODE_BIN=opencode
# [user] Orçamento de contexto do consumidor Claude e timeout do Graphify (s).
# CLAUDE_CONTEXT_BUDGET=6000
# GRAPHIFY_TIMEOUT_S=60
# GRAPHIFY_STALE_FALLBACK_S=0   # ANA-080: >0 => grafo desatualizado ha mais de N s => busca so BM25
# MG_INCREMENTAL_INDEX=0        # ANA-102: 1 = indice FTS5 incremental em disco (fora do vault)

# --- Retrieval: Personalized PageRank (experimental, desligado) ---
# PPR_ENABLED=false
# PPR_ALPHA=0.85
# PPR_ITERS=30
# PPR_TOP_N=15

# --- Camada de otimização: ajustes finos MG_OPT_* adicionais (defaults do código) ---
# MG_OPT_CONFLICT_CHECK=true
# MG_OPT_CONFLICT_DEMOTE=0.5
# MG_OPT_CONFLICT_OVERLAP=0.6
# MG_OPT_HEADER_SECTION_CHARS=60
# MG_OPT_HISTORICAL_DEMOTE=0.5
# MG_OPT_HISTORICAL_EXCLUDE=false
# MG_OPT_PROVENANCE=false
# MG_OPT_TEMPORAL_DEMOTE=true
# [user] Veredito por escopo (desligado): liga e limiares de tamanho de escopo.
# MG_VERDICT_ENABLED=false
# MG_VERDICT_SMALL_MAX=15
# MG_VERDICT_LARGE_MIN=50

