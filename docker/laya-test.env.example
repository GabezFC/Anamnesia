# Public template. Copy to docker/laya-test.env before running scripts/mglaya.py.
# Keep machine-specific paths and credentials only in that ignored local file.
LAYA_TEST_PORT=8030
OMP_THREADS=4
# Optional model directory: absolute path on your own machine, read-only bind.
# LAYA_MODELS_HOST=
# Optional vault; unset uses the repository synthetic corpus.
# ANAMNESIA_VAULT_HOST=
