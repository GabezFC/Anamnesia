# Public template. Copy to docker/mgtest.env before running scripts/mgtest.py.
# No personal paths or credentials are included. Local *.env files are ignored.
ANAMNESIA_PORT=8010
# Optional read-only host project roots; unset exposes no host projects.
# ANAMNESIA_PROJECTS_HOST=
# ANAMNESIA_PROJECTS_HOST2=
# Optional host-to-container path map, for your local roots only.
# ANAMNESIA_PATH_MAP=
# Optional vault; unset uses the repository synthetic corpus.
# ANAMNESIA_VAULT_HOST=
